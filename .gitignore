website/build/
website/.docusaurus/
website/.cache-loader/

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc

# Task timing logs (local benchmarks)
logs/

