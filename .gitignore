npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ESP-IDF build artifacts
software/build/
software/sdkconfig
software/sdkconfig.old
software/managed_components/
software/dependencies.lock

# Generated KiCad files (3D model injection for rendering)
hardware/kicad/esp32-emu-turbo-3d.kicad_pcb

# PCB parse cache (auto-generated by pcb_cache.py)
hardware/kicad/.pcb_cache.json

# KiCad lock files
hardware/kicad/~*.lck

# Zone-fill serialization lock (scripts/kicad_fill_zones.py)
*.fill.lock

# Claude Code local settings (personal overrides)
.claude/settings.local.json

# Claude Code session logs (runtime artifacts from context-bundle-builder)
.claude/session_logs/

# Pipeline checkpoint (runtime state for pipeline-resume skill)
.claude/pipeline-checkpoint.json

# Claude Code compaction backups (runtime artifacts from pre-compact-backup hook)
.claude/backups/

# External DFM analysis output (KiBot + Tracespace)
hardware/kicad/external-dfm-output/

# ERC report + its schematic fingerprint (erc_check.py regenerates on demand)
hardware/kicad/.erc-report.json
hardware/kicad/.erc-report.stamp

# EasyEDA reference footprints (verify_easyeda_footprint.py, LCSC-keyed).
# Tracked, not cached. Three manufacturing gates judge against this geometry
# (verify_easyeda_footprint, verify_cpl_rotation_law, analyze_pin1_marker), and
# a gate must judge against the reference that was actually reviewed, not
# against whatever the API serves today. Re-fetching on a miss also made the
# rotation law's verdict move run to run as an empty checkout warmed up, and
# the API rate-limits to HTTP 403 under concurrent agents. The .step models
# stay ignored: 66 MB, and nothing reads them (inject-3d-models.py uses the
# KiCad libraries instead).
scripts/.easyeda_cache/**/*.step
test-roms/*.sfc
test-roms/*.smc
test-roms/*.nes
test-roms/*.rom
software/sim/sim_test_native
software/sim/sim_test
software/sim/emu-turbo-sim
software/sim/test_nes

# Benchmark build artifacts
software/benchmark/build/
software/benchmark/sdkconfig
software/benchmark/sdkconfig.old
software/benchmark/dependencies.lock
software/benchmark/managed_components/
software/benchmark/spiffs_data/

# agent worktrees (transient, never committed)
.claude/worktrees/
