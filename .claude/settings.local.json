{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__ide__getDiagnostics",
      "Bash(cp hardware/kicad/jlcpcb/bom.csv hardware/kicad/jlcpcb/cpl.csv hardware/kicad/jlcpcb/bom-summary.md hardware/kicad/jlcpcb/gerbers.zip release_jlcpcb/)",
      "Bash(cp hardware/kicad/jlcpcb/bom.csv hardware/kicad/jlcpcb/cpl.csv hardware/kicad/jlcpcb/bom-summary.md hardware/kicad/jlcpcb/gerbers.zip release_jlcpcb/jlcpcb/)",
      "Bash(cp hardware/kicad/esp32-emu-turbo.kicad_pcb release_jlcpcb/)",
      "Bash(cp -R hardware/kicad/gerbers release_jlcpcb/gerbers)",
      "Bash(cp -R hardware/kicad/gerbers release_jlcpcb/jlcpcb/gerbers.tmp)",
      "Bash(cp -R hardware/kicad/gerbers release_jlcpcb/jlcpcb/gerbers)",
      "Bash(cp hardware/kicad/jlcpcb/bom.csv release_jlcpcb/bom.csv)",
      "Bash(cp hardware/kicad/jlcpcb/cpl.csv release_jlcpcb/cpl.csv)",
      "Bash(cp hardware/kicad/esp32-emu-turbo.kicad_pcb release_jlcpcb/esp32-emu-turbo.kicad_pcb)",
      "Bash(cp -r hardware/kicad/gerbers release_jlcpcb/gerbers)",
      "Bash(cp hardware/kicad/jlcpcb/gerbers.zip release_jlcpcb/gerbers.zip)",
      "Bash(rtk git *)",
      "Bash(easyeda2kicad --lcsc_id=C37704 --output=./eda_recheck --footprint)",
      "Bash(cp hardware/kicad/jlcpcb/bom.csv release_jlcpcb/jlcpcb/bom.csv)",
      "Bash(cp hardware/kicad/jlcpcb/cpl.csv release_jlcpcb/jlcpcb/cpl.csv)",
      "Bash(cp -r hardware/kicad/gerbers release_jlcpcb/jlcpcb/gerbers)",
      "Bash(cp hardware/kicad/jlcpcb/gerbers.zip release_jlcpcb/jlcpcb/gerbers.zip)",
      "Skill(hardware-audit)",
      "Bash(cp /Users/pierrejonnycau/Documents/WORKS/esp32-emu-turbo/scripts/verify_memory.py /Users/pierrejonnycau/Documents/WORKS/esp32-emu-turbo/.claude/worktrees/worktree-memory-gate/scripts/verify_memory.py)",
      "Bash(rtk ls *)",
      "mcp__pcbparts__jlc_get_part",
      "Bash(python3 scripts/erc_check.py)",
      "Bash(echo \"exit=$?\")",
      "Bash(git checkout *)",
      "mcp__pcbparts__jlc_get_pinout",
      "Bash(cp /tmp/collision.bak scripts/generate_pcb/collision.py)",
      "Bash(python3 scripts/test_collision_via_metric.py)",
      "Bash(make generate-pcb *)",
      "Skill(pcba-render)",
      "Skill(claude-api)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /home/pjonny/*)",
      "Bash(rm -rf /home/pjonny/Documents/*)",
      "Bash(rm -rf /home/pjonny/Documents/myProjects/*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "ltspice"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATH\" | grep -qE '(generate_pcb/|release_jlcpcb/|footprints|jlcpcb_export|\\.kicad_pcb)'; then echo '\\n>>> PCB/PCBA file modified — remember to run DFA verification: python3 scripts/verify_dfa.py'; fi"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATH\" | grep -qE '(generate_pcb/|release_jlcpcb/|footprints|jlcpcb_export|\\.kicad_pcb)'; then echo '\\n>>> PCB/PCBA file modified — remember to run DFA verification: python3 scripts/verify_dfa.py'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_BASH_COMMAND\" | grep -qE '(generate_pcb|verify_dfm|release)'; then echo '\\n>>> PCB pipeline command detected — remember to run DFA verification: python3 scripts/verify_dfa.py'; fi"
          }
        ]
      }
    ]
  }
}
