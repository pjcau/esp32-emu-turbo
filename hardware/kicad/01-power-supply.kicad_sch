  (text "Design Notes:" (at 30 240 0) (effects (font (size 2.54 2.54) bold) (justify left)))
  (text "- IP5306 eSOP-8: integrated charger + synchronous boost (no ext. Schottky)" (at 30 246 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- 1uH inductor: BAT -> L1 -> SW (>4.5A saturation, shielded)" (at 30 252 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- GND via exposed pad only (must solder to ground plane)" (at 30 258 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- KEY driven by C33 wake pulse (R16 100k pull-up DELETED)" (at 30 264 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- SY8089AAAC buck: 3.327V for ESP32-S3 and peripherals (2A cont., 3A peak)" (at 30 270 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- C2 (22uF tantalum) DELETED: reversed assembly destroyed prototype #1; C30 is a non-polarized MLCC" (at 30 276 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- 5.1k CC pull-downs identify USB-C UFP (5V sink)" (at 30 282 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- Battery: LiPo 3.7V 5000mAh via JST PH connector" (at 30 288 0) (effects (font (size 2.54 2.54)) (justify left)))

