  (text "Design Notes:" (at 30 178 0) (effects (font (size 2.54 2.54) bold) (justify left)))
  (text "- PAM8403: filterless Class-D stereo amplifier (3W per channel max)" (at 30 186 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- Only one channel used for mono audio" (at 30 192 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- No external DAC needed: ESP32-S3 has built-in I2S with DMA" (at 30 198 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- Powered from +5V rail for max headroom (3.3V limits volume)" (at 30 204 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- DMA-driven audio streaming for low CPU overhead" (at 30 210 0) (effects (font (size 2.54 2.54)) (justify left)))

