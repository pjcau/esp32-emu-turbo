  (text "- PAM8403: filterless Class-D stereo amplifier (3W per channel max)" (at 30 186 0) (effects (font (size 2.54 2.54)) (justify left)))
  (text "- Only one channel used for mono audio" (at 30 192 0) (effects (font (size 2.54 2.54)) (justify left)))
